{
  "name": "rayon-sdk-js",
  "version": "1.1.3",
  "description": "Server-side JavaScript and TypeScript client for Rayon API",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "RELEASE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayon-API/rayon-sdk-js.git"
  },
  "homepage": "https://github.com/Rayon-API/rayon-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/Rayon-API/rayon-sdk-js/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
